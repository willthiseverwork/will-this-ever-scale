# Optional model wording requires a verified distributed production rate limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-only sandbox credentials. Never use live credentials here.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_ACTION_SIGNING_SECRET=
# Set only after external per-IP limiting is verified.
AI_RATE_LIMIT_ENFORCED=
# Optional Vercel Blob token for 30-day reminders.
BLOB_READ_WRITE_TOKEN=
# Optional AWS Bedrock provider. No calls occur until the production limiter is verified.
AI_PROVIDER=bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
# Optional production-only Vercel OIDC; leave both blank to keep it off.
# WTES_BEDROCK_AUTH=vercel_oidc
WTES_BEDROCK_ROLE_ARN=
# Otherwise use either the scoped bearer token OR the scoped access key pair, not both.
# Do not combine OIDC with any of these credential values.
WTES_BEDROCK_API_KEY=
WTES_BEDROCK_ACCESS_KEY_ID=
WTES_BEDROCK_SECRET_ACCESS_KEY=
WTES_BEDROCK_SESSION_TOKEN=

# Optional model wording requires a verified distributed production rate limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-only sandbox credentials. Never use live credentials here.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_ACTION_SIGNING_SECRET=
# Set only after external per-IP limiting is verified.
AI_RATE_LIMIT_ENFORCED=
# Optional Vercel Blob token for 30-day reminders.
BLOB_READ_WRITE_TOKEN=
# Optional AWS Bedrock provider. No calls occur until the production limiter is verified.
AI_PROVIDER=bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
# Optional production-only Vercel OIDC; leave both blank to keep it off.
# WTES_BEDROCK_AUTH=vercel_oidc
WTES_BEDROCK_ROLE_ARN=
# Otherwise use either the scoped bearer token OR the scoped access key pair, not both.
# Do not combine OIDC with any of these credential values.
WTES_BEDROCK_API_KEY=
WTES_BEDROCK_ACCESS_KEY_ID=
WTES_BEDROCK_SECRET_ACCESS_KEY=
WTES_BEDROCK_SESSION_TOKEN=

# Dedicated account/workspace configuration; never reuse another product's credentials.
WTES_APP_ORIGIN=https://app.willthiseverscale.com
WTES_WORKOS_CLIENT_ID=
WTES_WORKOS_API_KEY=
WTES_SESSION_SECRET=
WTES_WORKSPACE_BLOB_TOKEN=
WTES_WORKSPACE_SECRET=
# Remote assistant OAuth must use this registered resource and the same verified identity.
WTES_MCP_WORKOS_ISSUER=
WTES_MCP_RESOURCE_URL=https://app.willthiseverscale.com/mcp
WTES_MCP_READ_SCOPE=
# Payments remain off until a dedicated catalog and lifecycle are verified.
WTES_BILLING_ENABLED=false
WTES_PADDLE_ENV=sandbox
WTES_PADDLE_API_KEY=
WTES_PADDLE_CLIENT_TOKEN=
WTES_PADDLE_PRICE_MONTHLY=
WTES_PADDLE_WEBHOOK_SECRET=
WTES_BILLING_SECRET=
WTES_BILLING_STORE_ID=

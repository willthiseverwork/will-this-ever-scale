# Copy to .env.local. Use sandbox credentials only; never commit secrets.
# Choose one Bedrock credential method; do not mix OIDC, bearer and access keys.

# Optional AI provider; bedrock or anthropic.
AI_PROVIDER=bedrock

# Set true only after distributed production rate limiting is verified.
AI_RATE_LIMIT_ENFORCED=

# Optional Anthropic API credential.
ANTHROPIC_API_KEY=

# Optional direct Anthropic model name.
ANTHROPIC_MODEL=

# Bedrock inference profile.
AWS_BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# Bedrock AWS region.
AWS_BEDROCK_REGION=us-east-1

# Private Blob token for limits, demo and action storage.
BLOB_READ_WRITE_TOKEN=

# Leave empty: toolkit debug output can expose payloads.
DEBUG=

# Node runtime environment; normally supplied by tooling.
NODE_ENV=

# Node test runner context; supplied by the runner.
NODE_TEST_CONTEXT=

# Random server secret of at least 32 bytes for PayPal actions.
PAYPAL_ACTION_SIGNING_SECRET=

# Sandbox Log in with PayPal app client ID.
PAYPAL_LOGIN_CLIENT_ID=

# Sandbox Log in with PayPal app client secret.
PAYPAL_LOGIN_CLIENT_SECRET=

# Sandbox buyer email for owner-only seed scripts.
PAYPAL_SANDBOX_BUYER_EMAIL=

# Sandbox REST app client ID.
PAYPAL_SANDBOX_CLIENT_ID=

# Sandbox REST app client secret.
PAYPAL_SANDBOX_CLIENT_SECRET=

# Private JSON buyer list for owner-only demo seed.
PAYPAL_SANDBOX_DEMO_BUYERS=

# Verified sandbox invoice IDs for demo setup.
PAYPAL_SANDBOX_DEMO_INVOICE_IDS=

# Verified demo merchant email for login matching.
PAYPAL_SANDBOX_DEMO_MERCHANT_EMAIL=

# Demo merchant ID for login matching.
PAYPAL_SANDBOX_DEMO_MERCHANT_ID=

# Vercel runtime indicator; supplied by Vercel.
VERCEL=

# Deployment identifier; supplied by Vercel.
VERCEL_DEPLOYMENT_ID=

# Vercel environment; supplied by Vercel.
VERCEL_ENV=

# Deployment hostname; supplied by Vercel.
VERCEL_URL=

# Enable account deletion when the remaining prerequisites are met.
WTES_ACCOUNT_DELETION_ENABLED=

# Canonical application origin for same-origin checks.
WTES_APP_ORIGIN=http://localhost:3000

# Optional scoped Bedrock access key ID.
WTES_BEDROCK_ACCESS_KEY_ID=

# Optional scoped Bedrock bearer token.
WTES_BEDROCK_API_KEY=

# Set vercel_oidc for the production OIDC route.
WTES_BEDROCK_AUTH=

# Dedicated AWS role ARN for production Bedrock and voice.
WTES_BEDROCK_ROLE_ARN=

# Optional scoped Bedrock secret access key.
WTES_BEDROCK_SECRET_ACCESS_KEY=

# Optional temporary Bedrock session token.
WTES_BEDROCK_SESSION_TOKEN=

# Enable billing only after provider verification.
WTES_BILLING_ENABLED=false

# Independent billing encryption secret of at least 32 bytes.
WTES_BILLING_SECRET=

# Paid launch timestamp in ISO 8601 format.
WTES_BILLING_STARTS_AT=

# Dedicated private Vercel Blob billing store ID.
WTES_BILLING_STORE_ID=

# Enable the isolated owner-only billing sandbox harness.
WTES_BILLING_TEST_ENABLED=false

# WorkOS user ID allowed to use the billing test harness.
WTES_BILLING_TEST_OWNER_USER_ID=

# Dedicated Paddle sandbox API key for the harness.
WTES_BILLING_TEST_PADDLE_API_KEY=

# Dedicated Paddle sandbox client token for the harness.
WTES_BILLING_TEST_PADDLE_CLIENT_TOKEN=

# Dedicated Paddle sandbox monthly price ID for the harness.
WTES_BILLING_TEST_PADDLE_PRICE_MONTHLY=

# Dedicated sandbox webhook secret for the harness.
WTES_BILLING_TEST_PADDLE_WEBHOOK_SECRET=

# Synthetic billing harness phase: active or expired.
WTES_BILLING_TEST_PHASE=

# Independent test billing secret of at least 32 bytes.
WTES_BILLING_TEST_SECRET=

# Dedicated private Blob store ID for billing tests.
WTES_BILLING_TEST_STORE_ID=

# Enable business state read-only mode.
WTES_BUSINESS_READ_ONLY=

# Enable the workspace fallback storage build probe.
WTES_FALLBACK_STORAGE_PROBE=

# Private identifier for the fallback storage probe.
WTES_FALLBACK_STORAGE_PROBE_ID=

# HTTPS target for explicitly authorized hosted QA.
WTES_HOSTED_TEST_URL=

# Judge access code configured on the server.
WTES_JUDGE_CODE=

# WorkOS scope required for private MCP reads.
WTES_MCP_READ_SCOPE=

# Registered private MCP resource URL.
WTES_MCP_RESOURCE_URL=

# WorkOS issuer for private MCP OAuth.
WTES_MCP_WORKOS_ISSUER=

# Dedicated Paddle API key.
WTES_PADDLE_API_KEY=

# Dedicated Paddle client-side token.
WTES_PADDLE_CLIENT_TOKEN=

# Paddle environment: sandbox or production.
WTES_PADDLE_ENV=sandbox

# Dedicated USD monthly Paddle price ID.
WTES_PADDLE_PRICE_MONTHLY=

# Paddle webhook signing secret.
WTES_PADDLE_WEBHOOK_SECRET=

# Owner-only payment-link probe bearer secret.
WTES_PAYMENT_LINK_PROBE_SECRET=

# Enable approved sandbox set payment links.
WTES_PAYPAL_SET_LINK_ENABLED=false

# Optional Playwright module path for QA scripts.
WTES_PLAYWRIGHT_PATH=

# Local server port for QA scripts.
WTES_QA_LOCAL_PORT=

# Local output directory for QA evidence.
WTES_QA_OUTPUT=

# Allow read-only real anonymous account and access QA requests.
WTES_QA_REAL_ANON=

# Path to a synthetic CSV for report QA.
WTES_READ_QA_CSV=

# WorkOS session encryption secret.
WTES_SESSION_SECRET=

# Optional Chrome executable for hosted QA.
WTES_TEST_CHROME_PATH=

# Optional hosted QA output directory.
WTES_TEST_OUTPUT_DIR=

# Optional voice interview model override.
WTES_VOICE_CHECK_MODEL=

# Enable voice input when dependencies are configured.
WTES_VOICE_ENABLED=false

# Enable voice interview and speech output.
WTES_VOICE_TALKBACK_ENABLED=false

# Dedicated WorkOS API key.
WTES_WORKOS_API_KEY=

# Dedicated WorkOS client ID.
WTES_WORKOS_CLIENT_ID=

# Dedicated WorkOS account-deletion API key.
WTES_WORKOS_DELETION_API_KEY=

# Private workspace Blob token for supported fallback storage.
WTES_WORKSPACE_BLOB_TOKEN=

# Independent workspace encryption secret of at least 32 bytes.
WTES_WORKSPACE_SECRET=

# Dedicated private Vercel Blob workspace store ID.
WTES_WORKSPACE_STORE_ID=
